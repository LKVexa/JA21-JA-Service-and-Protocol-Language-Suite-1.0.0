module corpus.ja_service.example_02429
use Service
policy explicit_network

service ServiceJASP_02429 {
    message Request6 { prompt: Text }
    message Response6 { token: Text, done: Flag }
    endpoint infer(request: Request6) -> Stream<Response6>
        auth capability model.infer
        deadline 6s
        retry max 0
        idempotency request.prompt
    protocol Session6 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02429.compatibility_report
