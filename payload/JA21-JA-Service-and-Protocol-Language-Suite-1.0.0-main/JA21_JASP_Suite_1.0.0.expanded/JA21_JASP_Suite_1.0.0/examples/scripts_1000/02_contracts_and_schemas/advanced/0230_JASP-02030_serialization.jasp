module corpus.ja_service.example_02030
use Service
policy explicit_network

service ServiceJASP_02030 {
    message Request92 { prompt: Text }
    message Response92 { token: Text, done: Flag }
    endpoint infer(request: Request92) -> Stream<Response92>
        auth capability model.infer
        deadline 92s
        retry max 0
        idempotency request.prompt
    protocol Session92 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02030.compatibility_report
