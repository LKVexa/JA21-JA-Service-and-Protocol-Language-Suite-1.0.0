module corpus.ja_service.example_05407
use Service
policy explicit_network

service ServiceJASP_05407 {
    message Request74 { prompt: Text }
    message Response74 { token: Text, done: Flag }
    endpoint infer(request: Request74) -> Stream<Response74>
        auth capability model.infer
        deadline 74s
        retry max 2
        idempotency request.prompt
    protocol Session74 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05407.compatibility_report
