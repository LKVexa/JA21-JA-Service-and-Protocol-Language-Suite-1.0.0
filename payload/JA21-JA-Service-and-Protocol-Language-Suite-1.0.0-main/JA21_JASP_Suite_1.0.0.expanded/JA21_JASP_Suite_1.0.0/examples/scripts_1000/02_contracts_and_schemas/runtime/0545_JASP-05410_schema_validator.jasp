module corpus.ja_service.example_05410
use Service
policy explicit_network

service ServiceJASP_05410 {
    message Request77 { prompt: Text }
    message Response77 { token: Text, done: Flag }
    endpoint infer(request: Request77) -> Stream<Response77>
        auth capability model.infer
        deadline 77s
        retry max 1
        idempotency request.prompt
    protocol Session77 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05410.compatibility_report
