module corpus.ja_service.example_05667
use Service
policy explicit_network

service ServiceJASP_05667 {
    message Request43 { prompt: Text }
    message Response43 { token: Text, done: Flag }
    endpoint infer(request: Request43) -> Stream<Response43>
        auth capability model.infer
        deadline 43s
        retry max 2
        idempotency request.prompt
    protocol Session43 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_05667.compatibility_report
