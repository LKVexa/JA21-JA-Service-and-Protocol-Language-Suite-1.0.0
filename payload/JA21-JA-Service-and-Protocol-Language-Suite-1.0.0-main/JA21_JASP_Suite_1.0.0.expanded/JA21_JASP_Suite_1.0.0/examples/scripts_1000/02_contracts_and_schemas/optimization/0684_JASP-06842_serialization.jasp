module corpus.ja_service.example_06842
use Service
policy explicit_network

service ServiceJASP_06842 {
    message Request54 { prompt: Text }
    message Response54 { token: Text, done: Flag }
    endpoint infer(request: Request54) -> Stream<Response54>
        auth capability model.infer
        deadline 54s
        retry max 3
        idempotency request.prompt
    protocol Session54 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06842.compatibility_report
