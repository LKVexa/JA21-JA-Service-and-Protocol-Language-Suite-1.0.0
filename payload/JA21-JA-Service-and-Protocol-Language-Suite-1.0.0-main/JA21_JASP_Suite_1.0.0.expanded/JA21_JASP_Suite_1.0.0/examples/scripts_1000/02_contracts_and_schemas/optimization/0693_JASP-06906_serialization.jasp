module corpus.ja_service.example_06906
use Service
policy explicit_network

service ServiceJASP_06906 {
    message Request21 { prompt: Text }
    message Response21 { token: Text, done: Flag }
    endpoint infer(request: Request21) -> Stream<Response21>
        auth capability model.infer
        deadline 21s
        retry max 1
        idempotency request.prompt
    protocol Session21 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06906.compatibility_report
