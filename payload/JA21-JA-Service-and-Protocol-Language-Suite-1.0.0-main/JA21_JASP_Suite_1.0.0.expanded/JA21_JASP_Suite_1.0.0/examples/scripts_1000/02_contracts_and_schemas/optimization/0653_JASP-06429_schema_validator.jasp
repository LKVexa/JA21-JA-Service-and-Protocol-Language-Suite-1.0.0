module corpus.ja_service.example_06429
use Service
policy explicit_network

service ServiceJASP_06429 {
    message Request29 { prompt: Text }
    message Response29 { token: Text, done: Flag }
    endpoint infer(request: Request29) -> Stream<Response29>
        auth capability model.infer
        deadline 29s
        retry max 1
        idempotency request.prompt
    protocol Session29 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06429.compatibility_report
