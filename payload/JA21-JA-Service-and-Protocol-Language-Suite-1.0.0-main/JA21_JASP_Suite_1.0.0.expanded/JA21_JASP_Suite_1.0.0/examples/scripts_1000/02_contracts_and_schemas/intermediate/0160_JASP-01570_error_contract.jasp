module corpus.ja_service.example_01570
use Service
policy explicit_network

service ServiceJASP_01570 {
    message Request20 { prompt: Text }
    message Response20 { token: Text, done: Flag }
    endpoint infer(request: Request20) -> Stream<Response20>
        auth capability model.infer
        deadline 20s
        retry max 1
        idempotency request.prompt
    protocol Session20 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_01570.compatibility_report
