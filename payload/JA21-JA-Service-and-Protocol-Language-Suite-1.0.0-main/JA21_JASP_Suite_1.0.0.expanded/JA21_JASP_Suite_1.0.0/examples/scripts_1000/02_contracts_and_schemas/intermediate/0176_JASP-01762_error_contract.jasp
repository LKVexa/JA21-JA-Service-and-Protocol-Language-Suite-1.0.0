module corpus.ja_service.example_01762
use Service
policy explicit_network

service ServiceJASP_01762 {
    message Request18 { prompt: Text }
    message Response18 { token: Text, done: Flag }
    endpoint infer(request: Request18) -> Stream<Response18>
        auth capability model.infer
        deadline 18s
        retry max 3
        idempotency request.prompt
    protocol Session18 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01762.compatibility_report
