module corpus.ja_service.example_01826
use Service
policy explicit_network

service ServiceJASP_01826 {
    message Request82 { prompt: Text }
    message Response82 { token: Text, done: Flag }
    endpoint infer(request: Request82) -> Stream<Response82>
        auth capability model.infer
        deadline 82s
        retry max 1
        idempotency request.prompt
    protocol Session82 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_01826.compatibility_report
