module corpus.ja_service.example_03405
use Service
policy explicit_network

service ServiceJASP_03405 {
    message Request12 { prompt: Text }
    message Response12 { token: Text, done: Flag }
    endpoint infer(request: Request12) -> Stream<Response12>
        auth capability model.infer
        deadline 12s
        retry max 3
        idempotency request.prompt
    protocol Session12 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03405.compatibility_report
