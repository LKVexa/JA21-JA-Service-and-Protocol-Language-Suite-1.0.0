module corpus.ja_service.example_09007
use Service
policy explicit_network

service ServiceJASP_09007 {
    message Request85 { prompt: Text }
    message Response85 { token: Text, done: Flag }
    endpoint infer(request: Request85) -> Stream<Response85>
        auth capability model.infer
        deadline 85s
        retry max 2
        idempotency request.prompt
    protocol Session85 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09007.compatibility_report
