module corpus.ja_service.example_09416
use Service
policy explicit_network

service ServiceJASP_09416 {
    message Request9 { prompt: Text }
    message Response9 { token: Text, done: Flag }
    endpoint infer(request: Request9) -> Stream<Response9>
        auth capability model.infer
        deadline 9s
        retry max 0
        idempotency request.prompt
    protocol Session9 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09416.compatibility_report
