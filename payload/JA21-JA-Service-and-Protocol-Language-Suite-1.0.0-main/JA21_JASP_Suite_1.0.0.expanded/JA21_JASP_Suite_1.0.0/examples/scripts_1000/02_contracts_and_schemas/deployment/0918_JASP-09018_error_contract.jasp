module corpus.ja_service.example_09018
use Service
policy explicit_network

service ServiceJASP_09018 {
    message Request96 { prompt: Text }
    message Response96 { token: Text, done: Flag }
    endpoint infer(request: Request96) -> Stream<Response96>
        auth capability model.infer
        deadline 96s
        retry max 1
        idempotency request.prompt
    protocol Session96 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09018.compatibility_report
