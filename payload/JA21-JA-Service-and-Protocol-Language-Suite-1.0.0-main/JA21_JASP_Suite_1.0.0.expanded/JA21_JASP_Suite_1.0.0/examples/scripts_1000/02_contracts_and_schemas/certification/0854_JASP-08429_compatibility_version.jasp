module corpus.ja_service.example_08429
use Service
policy explicit_network

service ServiceJASP_08429 {
    message Request89 { prompt: Text }
    message Response89 { token: Text, done: Flag }
    endpoint infer(request: Request89) -> Stream<Response89>
        auth capability model.infer
        deadline 89s
        retry max 1
        idempotency request.prompt
    protocol Session89 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08429.compatibility_report
