module corpus.ja_service.example_08432
use Service
policy explicit_network

service ServiceJASP_08432 {
    message Request92 { prompt: Text }
    message Response92 { token: Text, done: Flag }
    endpoint infer(request: Request92) -> Stream<Response92>
        auth capability model.infer
        deadline 92s
        retry max 1
        idempotency request.prompt
    protocol Session92 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08432.compatibility_report
