module corpus.ja_service.example_00967
use Service
policy explicit_network

service ServiceJASP_00967 {
    message Request96 { prompt: Text }
    message Response96 { token: Text, done: Flag }
    endpoint infer(request: Request96) -> Stream<Response96>
        auth capability model.infer
        deadline 96s
        retry max 3
        idempotency request.prompt
    protocol Session96 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_00967.compatibility_report
