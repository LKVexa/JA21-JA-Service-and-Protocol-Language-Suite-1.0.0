module corpus.ja_service.example_04424
use Service
policy explicit_network

service ServiceJASP_04424 {
    message Request61 { prompt: Text }
    message Response61 { token: Text, done: Flag }
    endpoint infer(request: Request61) -> Stream<Response61>
        auth capability model.infer
        deadline 61s
        retry max 3
        idempotency request.prompt
    protocol Session61 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04424.compatibility_report
