module corpus.ja_service.example_04423
use Service
policy explicit_network

service ServiceJASP_04423 {
    message Request60 { prompt: Text }
    message Response60 { token: Text, done: Flag }
    endpoint infer(request: Request60) -> Stream<Response60>
        auth capability model.infer
        deadline 60s
        retry max 2
        idempotency request.prompt
    protocol Session60 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04423.compatibility_report
