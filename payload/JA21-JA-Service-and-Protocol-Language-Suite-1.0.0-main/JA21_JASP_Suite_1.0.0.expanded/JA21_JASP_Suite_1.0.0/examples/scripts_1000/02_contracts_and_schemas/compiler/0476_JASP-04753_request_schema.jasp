module corpus.ja_service.example_04753
use Service
policy explicit_network

service ServiceJASP_04753 {
    message Request2 { prompt: Text }
    message Response2 { token: Text, done: Flag }
    endpoint infer(request: Request2) -> Stream<Response2>
        auth capability model.infer
        deadline 2s
        retry max 3
        idempotency request.prompt
    protocol Session2 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04753.compatibility_report
