module corpus.ja_service.example_04935
use Service
policy explicit_network

service ServiceJASP_04935 {
    message Request87 { prompt: Text }
    message Response87 { token: Text, done: Flag }
    endpoint infer(request: Request87) -> Stream<Response87>
        auth capability model.infer
        deadline 87s
        retry max 3
        idempotency request.prompt
    protocol Session87 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_04935.compatibility_report
