module corpus.ja_service.example_04420
use Service
policy explicit_network

service ServiceJASP_04420 {
    message Request57 { prompt: Text }
    message Response57 { token: Text, done: Flag }
    endpoint infer(request: Request57) -> Stream<Response57>
        auth capability model.infer
        deadline 57s
        retry max 3
        idempotency request.prompt
    protocol Session57 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04420.compatibility_report
