module corpus.ja_service.example_04401
use Service
policy explicit_network

service ServiceJASP_04401 {
    message Request38 { prompt: Text }
    message Response38 { token: Text, done: Flag }
    endpoint infer(request: Request38) -> Stream<Response38>
        auth capability model.infer
        deadline 38s
        retry max 3
        idempotency request.prompt
    protocol Session38 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04401.compatibility_report
