module corpus.ja_service.example_07765
use Service
policy explicit_network

service ServiceJASP_07765 {
    message Request7 { prompt: Text }
    message Response7 { token: Text, done: Flag }
    endpoint infer(request: Request7) -> Stream<Response7>
        auth capability model.infer
        deadline 7s
        retry max 0
        idempotency request.prompt
    protocol Session7 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_07765.compatibility_report
