module corpus.ja_service.example_07010
use Service
policy explicit_network

service ServiceJASP_07010 {
    message Request28 { prompt: Text }
    message Response28 { token: Text, done: Flag }
    endpoint infer(request: Request28) -> Stream<Response28>
        auth capability model.infer
        deadline 28s
        retry max 1
        idempotency request.prompt
    protocol Session28 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_07010.compatibility_report
