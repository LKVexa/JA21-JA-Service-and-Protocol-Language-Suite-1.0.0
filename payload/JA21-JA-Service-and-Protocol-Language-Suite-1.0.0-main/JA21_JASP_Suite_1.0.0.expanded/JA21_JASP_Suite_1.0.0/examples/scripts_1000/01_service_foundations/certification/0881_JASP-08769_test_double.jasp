module corpus.ja_service.example_08769
use Service
policy explicit_network

service ServiceJASP_08769 {
    message Request41 { prompt: Text }
    message Response41 { token: Text, done: Flag }
    endpoint infer(request: Request41) -> Stream<Response41>
        auth capability model.infer
        deadline 41s
        retry max 0
        idempotency request.prompt
    protocol Session41 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08769.compatibility_report
