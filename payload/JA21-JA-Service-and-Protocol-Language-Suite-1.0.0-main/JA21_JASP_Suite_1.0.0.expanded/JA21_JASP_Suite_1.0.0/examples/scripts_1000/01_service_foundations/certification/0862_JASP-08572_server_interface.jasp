module corpus.ja_service.example_08572
use Service
policy explicit_network

service ServiceJASP_08572 {
    message Request38 { prompt: Text }
    message Response38 { token: Text, done: Flag }
    endpoint infer(request: Request38) -> Stream<Response38>
        auth capability model.infer
        deadline 38s
        retry max 1
        idempotency request.prompt
    protocol Session38 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08572.compatibility_report
