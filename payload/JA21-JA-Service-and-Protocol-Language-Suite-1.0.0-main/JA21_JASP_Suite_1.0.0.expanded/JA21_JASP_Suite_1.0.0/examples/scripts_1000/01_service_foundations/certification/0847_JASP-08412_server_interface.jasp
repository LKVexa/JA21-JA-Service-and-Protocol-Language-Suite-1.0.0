module corpus.ja_service.example_08412
use Service
policy explicit_network

service ServiceJASP_08412 {
    message Request72 { prompt: Text }
    message Response72 { token: Text, done: Flag }
    endpoint infer(request: Request72) -> Stream<Response72>
        auth capability model.infer
        deadline 72s
        retry max 0
        idempotency request.prompt
    protocol Session72 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08412.compatibility_report
