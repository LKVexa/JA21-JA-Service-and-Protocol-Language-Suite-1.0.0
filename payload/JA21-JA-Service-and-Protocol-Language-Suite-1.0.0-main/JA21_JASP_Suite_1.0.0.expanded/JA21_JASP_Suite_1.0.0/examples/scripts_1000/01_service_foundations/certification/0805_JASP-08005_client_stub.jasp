module corpus.ja_service.example_08005
use Service
policy explicit_network

service ServiceJASP_08005 {
    message Request53 { prompt: Text }
    message Response53 { token: Text, done: Flag }
    endpoint infer(request: Request53) -> Stream<Response53>
        auth capability model.infer
        deadline 53s
        retry max 0
        idempotency request.prompt
    protocol Session53 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08005.compatibility_report
