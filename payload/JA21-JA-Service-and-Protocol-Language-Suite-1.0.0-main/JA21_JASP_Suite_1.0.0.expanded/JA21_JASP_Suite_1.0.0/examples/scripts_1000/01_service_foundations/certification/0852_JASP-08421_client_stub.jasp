module corpus.ja_service.example_08421
use Service
policy explicit_network

service ServiceJASP_08421 {
    message Request81 { prompt: Text }
    message Response81 { token: Text, done: Flag }
    endpoint infer(request: Request81) -> Stream<Response81>
        auth capability model.infer
        deadline 81s
        retry max 1
        idempotency request.prompt
    protocol Session81 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08421.compatibility_report
