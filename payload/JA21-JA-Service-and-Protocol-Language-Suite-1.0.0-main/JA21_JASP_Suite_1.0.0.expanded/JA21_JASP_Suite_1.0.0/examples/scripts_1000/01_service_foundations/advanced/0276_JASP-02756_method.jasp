module corpus.ja_service.example_02756
use Service
policy explicit_network

service ServiceJASP_02756 {
    message Request42 { prompt: Text }
    message Response42 { token: Text, done: Flag }
    endpoint infer(request: Request42) -> Stream<Response42>
        auth capability model.infer
        deadline 42s
        retry max 1
        idempotency request.prompt
    protocol Session42 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02756.compatibility_report
