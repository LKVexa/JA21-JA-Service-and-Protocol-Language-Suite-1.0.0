module corpus.ja_service.example_02413
use Service
policy explicit_network

service ServiceJASP_02413 {
    message Request87 { prompt: Text }
    message Response87 { token: Text, done: Flag }
    endpoint infer(request: Request87) -> Stream<Response87>
        auth capability model.infer
        deadline 87s
        retry max 3
        idempotency request.prompt
    protocol Session87 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02413.compatibility_report
