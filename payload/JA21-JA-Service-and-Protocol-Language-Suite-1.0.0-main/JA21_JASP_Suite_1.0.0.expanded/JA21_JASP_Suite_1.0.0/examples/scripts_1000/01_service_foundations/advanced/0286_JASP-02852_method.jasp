module corpus.ja_service.example_02852
use Service
policy explicit_network

service ServiceJASP_02852 {
    message Request41 { prompt: Text }
    message Response41 { token: Text, done: Flag }
    endpoint infer(request: Request41) -> Stream<Response41>
        auth capability model.infer
        deadline 41s
        retry max 1
        idempotency request.prompt
    protocol Session41 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02852.compatibility_report
