module corpus.ja_service.example_02765
use Service
policy explicit_network

service ServiceJASP_02765 {
    message Request51 { prompt: Text }
    message Response51 { token: Text, done: Flag }
    endpoint infer(request: Request51) -> Stream<Response51>
        auth capability model.infer
        deadline 51s
        retry max 3
        idempotency request.prompt
    protocol Session51 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02765.compatibility_report
