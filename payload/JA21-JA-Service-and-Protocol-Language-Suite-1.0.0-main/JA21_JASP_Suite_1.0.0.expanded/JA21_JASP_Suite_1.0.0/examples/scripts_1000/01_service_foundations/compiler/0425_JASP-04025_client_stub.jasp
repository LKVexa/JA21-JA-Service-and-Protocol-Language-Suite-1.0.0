module corpus.ja_service.example_04025
use Service
policy explicit_network

service ServiceJASP_04025 {
    message Request50 { prompt: Text }
    message Response50 { token: Text, done: Flag }
    endpoint infer(request: Request50) -> Stream<Response50>
        auth capability model.infer
        deadline 50s
        retry max 3
        idempotency request.prompt
    protocol Session50 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_04025.compatibility_report
