module corpus.ja_service.example_09418
use Service
policy explicit_network

service ServiceJASP_09418 {
    message Request11 { prompt: Text }
    message Response11 { token: Text, done: Flag }
    endpoint infer(request: Request11) -> Stream<Response11>
        auth capability model.infer
        deadline 11s
        retry max 2
        idempotency request.prompt
    protocol Session11 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09418.compatibility_report
