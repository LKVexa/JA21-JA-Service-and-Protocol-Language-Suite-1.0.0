module corpus.ja_service.example_09985
use Service
policy explicit_network

service ServiceJASP_09985 {
    message Request93 { prompt: Text }
    message Response93 { token: Text, done: Flag }
    endpoint infer(request: Request93) -> Stream<Response93>
        auth capability model.infer
        deadline 93s
        retry max 0
        idempotency request.prompt
    protocol Session93 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09985.compatibility_report
