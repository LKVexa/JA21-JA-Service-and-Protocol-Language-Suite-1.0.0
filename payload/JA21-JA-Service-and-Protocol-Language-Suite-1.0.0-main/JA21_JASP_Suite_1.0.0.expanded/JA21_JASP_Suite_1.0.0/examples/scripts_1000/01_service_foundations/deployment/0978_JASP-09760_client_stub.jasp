module corpus.ja_service.example_09760
use Service
policy explicit_network

service ServiceJASP_09760 {
    message Request62 { prompt: Text }
    message Response62 { token: Text, done: Flag }
    endpoint infer(request: Request62) -> Stream<Response62>
        auth capability model.infer
        deadline 62s
        retry max 3
        idempotency request.prompt
    protocol Session62 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09760.compatibility_report
