module corpus.ja_service.example_09427
use Service
policy explicit_network

service ServiceJASP_09427 {
    message Request20 { prompt: Text }
    message Response20 { token: Text, done: Flag }
    endpoint infer(request: Request20) -> Stream<Response20>
        auth capability model.infer
        deadline 20s
        retry max 0
        idempotency request.prompt
    protocol Session20 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09427.compatibility_report
