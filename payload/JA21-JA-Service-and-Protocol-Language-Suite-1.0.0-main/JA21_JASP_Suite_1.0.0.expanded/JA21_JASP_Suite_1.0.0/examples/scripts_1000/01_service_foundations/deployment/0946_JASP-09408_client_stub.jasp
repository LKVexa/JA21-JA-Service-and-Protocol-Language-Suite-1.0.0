module corpus.ja_service.example_09408
use Service
policy explicit_network

service ServiceJASP_09408 {
    message Request98 { prompt: Text }
    message Response98 { token: Text, done: Flag }
    endpoint infer(request: Request98) -> Stream<Response98>
        auth capability model.infer
        deadline 98s
        retry max 0
        idempotency request.prompt
    protocol Session98 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09408.compatibility_report
