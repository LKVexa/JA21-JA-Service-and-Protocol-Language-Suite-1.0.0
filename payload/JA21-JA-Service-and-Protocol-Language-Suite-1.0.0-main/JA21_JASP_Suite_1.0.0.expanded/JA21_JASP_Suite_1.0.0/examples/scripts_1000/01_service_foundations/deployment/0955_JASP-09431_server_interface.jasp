module corpus.ja_service.example_09431
use Service
policy explicit_network

service ServiceJASP_09431 {
    message Request24 { prompt: Text }
    message Response24 { token: Text, done: Flag }
    endpoint infer(request: Request24) -> Stream<Response24>
        auth capability model.infer
        deadline 24s
        retry max 0
        idempotency request.prompt
    protocol Session24 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09431.compatibility_report
