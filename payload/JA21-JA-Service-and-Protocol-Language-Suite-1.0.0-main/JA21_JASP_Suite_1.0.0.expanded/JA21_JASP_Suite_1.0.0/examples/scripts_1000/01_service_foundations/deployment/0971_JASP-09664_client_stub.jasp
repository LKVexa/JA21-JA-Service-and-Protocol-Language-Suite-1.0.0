module corpus.ja_service.example_09664
use Service
policy explicit_network

service ServiceJASP_09664 {
    message Request63 { prompt: Text }
    message Response63 { token: Text, done: Flag }
    endpoint infer(request: Request63) -> Stream<Response63>
        auth capability model.infer
        deadline 63s
        retry max 0
        idempotency request.prompt
    protocol Session63 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09664.compatibility_report
