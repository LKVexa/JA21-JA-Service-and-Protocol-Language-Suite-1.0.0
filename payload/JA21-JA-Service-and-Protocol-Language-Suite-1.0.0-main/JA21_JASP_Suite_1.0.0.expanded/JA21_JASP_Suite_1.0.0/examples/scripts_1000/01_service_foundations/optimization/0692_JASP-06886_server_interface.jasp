module corpus.ja_service.example_06886
use Service
policy explicit_network

service ServiceJASP_06886 {
    message Request98 { prompt: Text }
    message Response98 { token: Text, done: Flag }
    endpoint infer(request: Request98) -> Stream<Response98>
        auth capability model.infer
        deadline 98s
        retry max 1
        idempotency request.prompt
    protocol Session98 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06886.compatibility_report
