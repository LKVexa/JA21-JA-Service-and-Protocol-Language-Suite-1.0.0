module corpus.ja_service.example_07777
use Service
policy explicit_network

service ServiceJASP_07777 {
    message Request19 { prompt: Text }
    message Response19 { token: Text, done: Flag }
    endpoint infer(request: Request19) -> Stream<Response19>
        auth capability model.infer
        deadline 19s
        retry max 0
        idempotency request.prompt
    protocol Session19 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_07777.compatibility_report
