module corpus.ja_service.example_07558
use Service
policy explicit_network

service ServiceJASP_07558 {
    message Request91 { prompt: Text }
    message Response91 { token: Text, done: Flag }
    endpoint infer(request: Request91) -> Stream<Response91>
        auth capability model.infer
        deadline 91s
        retry max 2
        idempotency request.prompt
    protocol Session91 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_07558.compatibility_report
