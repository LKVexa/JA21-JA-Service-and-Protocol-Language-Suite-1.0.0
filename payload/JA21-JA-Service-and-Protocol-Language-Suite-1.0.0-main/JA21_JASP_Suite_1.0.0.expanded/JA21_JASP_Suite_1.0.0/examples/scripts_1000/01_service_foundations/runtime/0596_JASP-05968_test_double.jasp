module corpus.ja_service.example_05968
use Service
policy explicit_network

service ServiceJASP_05968 {
    message Request53 { prompt: Text }
    message Response53 { token: Text, done: Flag }
    endpoint infer(request: Request53) -> Stream<Response53>
        auth capability model.infer
        deadline 53s
        retry max 1
        idempotency request.prompt
    protocol Session53 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05968.compatibility_report
