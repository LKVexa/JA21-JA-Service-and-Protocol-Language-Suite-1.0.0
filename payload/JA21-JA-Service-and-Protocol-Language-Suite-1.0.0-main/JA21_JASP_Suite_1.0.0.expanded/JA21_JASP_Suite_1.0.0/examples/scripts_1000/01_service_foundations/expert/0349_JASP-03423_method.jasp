module corpus.ja_service.example_03423
use Service
policy explicit_network

service ServiceJASP_03423 {
    message Request30 { prompt: Text }
    message Response30 { token: Text, done: Flag }
    endpoint infer(request: Request30) -> Stream<Response30>
        auth capability model.infer
        deadline 30s
        retry max 2
        idempotency request.prompt
    protocol Session30 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03423.compatibility_report
