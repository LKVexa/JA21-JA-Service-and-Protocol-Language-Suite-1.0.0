module corpus.ja_service.example_03839
use Service
policy explicit_network

service ServiceJASP_03839 {
    message Request58 { prompt: Text }
    message Response58 { token: Text, done: Flag }
    endpoint infer(request: Request58) -> Stream<Response58>
        auth capability model.infer
        deadline 58s
        retry max 3
        idempotency request.prompt
    protocol Session58 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_03839.compatibility_report
