module corpus.ja_service.example_03432
use Service
policy explicit_network

service ServiceJASP_03432 {
    message Request39 { prompt: Text }
    message Response39 { token: Text, done: Flag }
    endpoint infer(request: Request39) -> Stream<Response39>
        auth capability model.infer
        deadline 39s
        retry max 3
        idempotency request.prompt
    protocol Session39 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03432.compatibility_report
