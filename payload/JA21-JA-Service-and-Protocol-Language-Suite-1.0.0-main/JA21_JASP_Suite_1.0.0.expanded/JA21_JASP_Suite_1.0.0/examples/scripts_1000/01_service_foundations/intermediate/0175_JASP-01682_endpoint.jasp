module corpus.ja_service.example_01682
use Service
policy explicit_network

service ServiceJASP_01682 {
    message Request35 { prompt: Text }
    message Response35 { token: Text, done: Flag }
    endpoint infer(request: Request35) -> Stream<Response35>
        auth capability model.infer
        deadline 35s
        retry max 1
        idempotency request.prompt
    protocol Session35 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_01682.compatibility_report
