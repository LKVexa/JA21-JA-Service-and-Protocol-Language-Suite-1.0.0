module corpus.ja_service.example_00950
use Service
policy explicit_network

service ServiceJASP_00950 {
    message Request79 { prompt: Text }
    message Response79 { token: Text, done: Flag }
    endpoint infer(request: Request79) -> Stream<Response79>
        auth capability model.infer
        deadline 79s
        retry max 1
        idempotency request.prompt
    protocol Session79 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_00950.compatibility_report
