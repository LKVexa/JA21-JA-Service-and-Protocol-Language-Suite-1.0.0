module corpus.ja_service.example_04766
use Service
policy explicit_network

service ServiceJASP_04766 {
    message Request15 { prompt: Text }
    message Response15 { token: Text, done: Flag }
    endpoint infer(request: Request15) -> Stream<Response15>
        auth capability model.infer
        deadline 15s
        retry max 0
        idempotency request.prompt
    protocol Session15 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04766.compatibility_report
