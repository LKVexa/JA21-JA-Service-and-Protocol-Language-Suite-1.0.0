module corpus.ja_service.example_04778
use Service
policy explicit_network

service ServiceJASP_04778 {
    message Request27 { prompt: Text }
    message Response27 { token: Text, done: Flag }
    endpoint infer(request: Request27) -> Stream<Response27>
        auth capability model.infer
        deadline 27s
        retry max 1
        idempotency request.prompt
    protocol Session27 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04778.compatibility_report
