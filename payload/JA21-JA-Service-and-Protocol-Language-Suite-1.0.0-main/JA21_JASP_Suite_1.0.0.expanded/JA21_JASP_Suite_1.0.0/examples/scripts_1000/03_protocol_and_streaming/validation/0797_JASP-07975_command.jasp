module corpus.ja_service.example_07975
use Service
policy explicit_network

service ServiceJASP_07975 {
    message Request23 { prompt: Text }
    message Response23 { token: Text, done: Flag }
    endpoint infer(request: Request23) -> Stream<Response23>
        auth capability model.infer
        deadline 23s
        retry max 1
        idempotency request.prompt
    protocol Session23 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_07975.compatibility_report
