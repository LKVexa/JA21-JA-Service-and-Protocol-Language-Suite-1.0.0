module corpus.ja_service.example_07024
use Service
policy explicit_network

service ServiceJASP_07024 {
    message Request42 { prompt: Text }
    message Response42 { token: Text, done: Flag }
    endpoint infer(request: Request42) -> Stream<Response42>
        auth capability model.infer
        deadline 42s
        retry max 3
        idempotency request.prompt
    protocol Session42 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_07024.compatibility_report
