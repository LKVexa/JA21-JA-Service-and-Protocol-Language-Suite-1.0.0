module corpus.ja_service.example_02409
use Service
policy explicit_network

service ServiceJASP_02409 {
    message Request83 { prompt: Text }
    message Response83 { token: Text, done: Flag }
    endpoint infer(request: Request83) -> Stream<Response83>
        auth capability model.infer
        deadline 83s
        retry max 3
        idempotency request.prompt
    protocol Session83 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02409.compatibility_report
