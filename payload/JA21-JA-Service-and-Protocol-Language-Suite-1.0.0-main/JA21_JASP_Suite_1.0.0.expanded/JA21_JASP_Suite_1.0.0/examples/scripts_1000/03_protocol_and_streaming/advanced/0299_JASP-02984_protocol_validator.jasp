module corpus.ja_service.example_02984
use Service
policy explicit_network

service ServiceJASP_02984 {
    message Request76 { prompt: Text }
    message Response76 { token: Text, done: Flag }
    endpoint infer(request: Request76) -> Stream<Response76>
        auth capability model.infer
        deadline 76s
        retry max 1
        idempotency request.prompt
    protocol Session76 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02984.compatibility_report
