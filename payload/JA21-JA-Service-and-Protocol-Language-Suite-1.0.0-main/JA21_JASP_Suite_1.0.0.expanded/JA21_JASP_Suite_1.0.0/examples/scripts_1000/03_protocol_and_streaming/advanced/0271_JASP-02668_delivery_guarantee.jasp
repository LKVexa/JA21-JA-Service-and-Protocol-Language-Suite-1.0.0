module corpus.ja_service.example_02668
use Service
policy explicit_network

service ServiceJASP_02668 {
    message Request51 { prompt: Text }
    message Response51 { token: Text, done: Flag }
    endpoint infer(request: Request51) -> Stream<Response51>
        auth capability model.infer
        deadline 51s
        retry max 3
        idempotency request.prompt
    protocol Session51 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02668.compatibility_report
