module corpus.ja_service.example_03759
use Service
policy explicit_network

service ServiceJASP_03759 {
    message Request75 { prompt: Text }
    message Response75 { token: Text, done: Flag }
    endpoint infer(request: Request75) -> Stream<Response75>
        auth capability model.infer
        deadline 75s
        retry max 1
        idempotency request.prompt
    protocol Session75 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03759.compatibility_report
