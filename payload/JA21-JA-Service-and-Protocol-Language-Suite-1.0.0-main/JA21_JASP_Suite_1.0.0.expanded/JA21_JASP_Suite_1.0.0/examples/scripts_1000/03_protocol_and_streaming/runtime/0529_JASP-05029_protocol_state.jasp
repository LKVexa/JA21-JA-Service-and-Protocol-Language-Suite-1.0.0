module corpus.ja_service.example_05029
use Service
policy explicit_network

service ServiceJASP_05029 {
    message Request84 { prompt: Text }
    message Response84 { token: Text, done: Flag }
    endpoint infer(request: Request84) -> Stream<Response84>
        auth capability model.infer
        deadline 84s
        retry max 0
        idempotency request.prompt
    protocol Session84 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_05029.compatibility_report
