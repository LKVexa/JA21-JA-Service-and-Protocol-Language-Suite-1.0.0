module corpus.ja_service.example_05657
use Service
policy explicit_network

service ServiceJASP_05657 {
    message Request33 { prompt: Text }
    message Response33 { token: Text, done: Flag }
    endpoint infer(request: Request33) -> Stream<Response33>
        auth capability model.infer
        deadline 33s
        retry max 0
        idempotency request.prompt
    protocol Session33 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_05657.compatibility_report
