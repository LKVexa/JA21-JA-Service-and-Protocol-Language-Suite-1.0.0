module corpus.ja_service.example_08418
use Service
policy explicit_network

service ServiceJASP_08418 {
    message Request78 { prompt: Text }
    message Response78 { token: Text, done: Flag }
    endpoint infer(request: Request78) -> Stream<Response78>
        auth capability model.infer
        deadline 78s
        retry max 2
        idempotency request.prompt
    protocol Session78 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08418.compatibility_report
