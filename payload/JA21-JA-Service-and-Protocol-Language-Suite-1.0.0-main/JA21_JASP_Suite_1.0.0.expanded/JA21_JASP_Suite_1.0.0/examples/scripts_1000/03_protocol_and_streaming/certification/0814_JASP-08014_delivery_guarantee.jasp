module corpus.ja_service.example_08014
use Service
policy explicit_network

service ServiceJASP_08014 {
    message Request62 { prompt: Text }
    message Response62 { token: Text, done: Flag }
    endpoint infer(request: Request62) -> Stream<Response62>
        auth capability model.infer
        deadline 62s
        retry max 1
        idempotency request.prompt
    protocol Session62 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08014.compatibility_report
