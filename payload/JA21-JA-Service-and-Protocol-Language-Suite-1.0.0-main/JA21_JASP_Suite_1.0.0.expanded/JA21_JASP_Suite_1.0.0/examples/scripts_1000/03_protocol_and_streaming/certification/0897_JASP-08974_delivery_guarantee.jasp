module corpus.ja_service.example_08974
use Service
policy explicit_network

service ServiceJASP_08974 {
    message Request52 { prompt: Text }
    message Response52 { token: Text, done: Flag }
    endpoint infer(request: Request52) -> Stream<Response52>
        auth capability model.infer
        deadline 52s
        retry max 0
        idempotency request.prompt
    protocol Session52 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08974.compatibility_report
