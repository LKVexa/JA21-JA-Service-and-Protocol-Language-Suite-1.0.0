module corpus.ja_service.example_09780
use Service
policy explicit_network

service ServiceJASP_09780 {
    message Request82 { prompt: Text }
    message Response82 { token: Text, done: Flag }
    endpoint infer(request: Request82) -> Stream<Response82>
        auth capability model.infer
        deadline 82s
        retry max 0
        idempotency request.prompt
    protocol Session82 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09780.compatibility_report
