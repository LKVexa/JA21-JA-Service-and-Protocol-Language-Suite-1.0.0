module corpus.ja_service.example_09876
use Service
policy explicit_network

service ServiceJASP_09876 {
    message Request81 { prompt: Text }
    message Response81 { token: Text, done: Flag }
    endpoint infer(request: Request81) -> Stream<Response81>
        auth capability model.infer
        deadline 81s
        retry max 3
        idempotency request.prompt
    protocol Session81 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09876.compatibility_report
