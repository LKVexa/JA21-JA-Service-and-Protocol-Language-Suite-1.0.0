module corpus.ja_service.example_01425
use Service
policy explicit_network

service ServiceJASP_01425 {
    message Request69 { prompt: Text }
    message Response69 { token: Text, done: Flag }
    endpoint infer(request: Request69) -> Stream<Response69>
        auth capability model.infer
        deadline 69s
        retry max 3
        idempotency request.prompt
    protocol Session69 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01425.compatibility_report
