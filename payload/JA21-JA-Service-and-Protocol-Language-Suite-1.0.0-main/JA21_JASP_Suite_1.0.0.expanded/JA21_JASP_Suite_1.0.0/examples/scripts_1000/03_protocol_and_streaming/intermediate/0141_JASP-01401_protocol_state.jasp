module corpus.ja_service.example_01401
use Service
policy explicit_network

service ServiceJASP_01401 {
    message Request45 { prompt: Text }
    message Response45 { token: Text, done: Flag }
    endpoint infer(request: Request45) -> Stream<Response45>
        auth capability model.infer
        deadline 45s
        retry max 3
        idempotency request.prompt
    protocol Session45 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01401.compatibility_report
