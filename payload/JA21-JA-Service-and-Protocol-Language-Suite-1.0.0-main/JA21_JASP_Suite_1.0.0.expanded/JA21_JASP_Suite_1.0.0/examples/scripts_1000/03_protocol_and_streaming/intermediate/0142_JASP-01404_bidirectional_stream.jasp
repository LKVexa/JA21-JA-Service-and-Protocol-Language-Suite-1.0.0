module corpus.ja_service.example_01404
use Service
policy explicit_network

service ServiceJASP_01404 {
    message Request48 { prompt: Text }
    message Response48 { token: Text, done: Flag }
    endpoint infer(request: Request48) -> Stream<Response48>
        auth capability model.infer
        deadline 48s
        retry max 2
        idempotency request.prompt
    protocol Session48 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01404.compatibility_report
