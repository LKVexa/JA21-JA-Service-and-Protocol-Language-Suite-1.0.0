module corpus.ja_service.example_01029
use Service
policy explicit_network

service ServiceJASP_01029 {
    message Request61 { prompt: Text }
    message Response61 { token: Text, done: Flag }
    endpoint infer(request: Request61) -> Stream<Response61>
        auth capability model.infer
        deadline 61s
        retry max 3
        idempotency request.prompt
    protocol Session61 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_01029.compatibility_report
