module corpus.ja_service.example_06005
use Service
policy explicit_network

service ServiceJASP_06005 {
    message Request90 { prompt: Text }
    message Response90 { token: Text, done: Flag }
    endpoint infer(request: Request90) -> Stream<Response90>
        auth capability model.infer
        deadline 90s
        retry max 3
        idempotency request.prompt
    protocol Session90 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06005.compatibility_report
