module corpus.ja_service.example_01574
use Service
policy explicit_network

service ServiceJASP_01574 {
    message Request24 { prompt: Text }
    message Response24 { token: Text, done: Flag }
    endpoint infer(request: Request24) -> Stream<Response24>
        auth capability model.infer
        deadline 24s
        retry max 1
        idempotency request.prompt
    protocol Session24 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_01574.compatibility_report
