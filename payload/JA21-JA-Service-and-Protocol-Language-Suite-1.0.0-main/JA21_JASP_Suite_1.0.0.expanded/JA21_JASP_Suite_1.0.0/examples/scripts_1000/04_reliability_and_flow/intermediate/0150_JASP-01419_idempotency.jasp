module corpus.ja_service.example_01419
use Service
policy explicit_network

service ServiceJASP_01419 {
    message Request63 { prompt: Text }
    message Response63 { token: Text, done: Flag }
    endpoint infer(request: Request63) -> Stream<Response63>
        auth capability model.infer
        deadline 63s
        retry max 1
        idempotency request.prompt
    protocol Session63 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01419.compatibility_report
