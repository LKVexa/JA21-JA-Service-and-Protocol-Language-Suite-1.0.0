module corpus.ja_service.example_08753
use Service
policy explicit_network

service ServiceJASP_08753 {
    message Request25 { prompt: Text }
    message Response25 { token: Text, done: Flag }
    endpoint infer(request: Request25) -> Stream<Response25>
        auth capability model.infer
        deadline 25s
        retry max 0
        idempotency request.prompt
    protocol Session25 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08753.compatibility_report
