module corpus.ja_service.example_08561
use Service
policy explicit_network

service ServiceJASP_08561 {
    message Request27 { prompt: Text }
    message Response27 { token: Text, done: Flag }
    endpoint infer(request: Request27) -> Stream<Response27>
        auth capability model.infer
        deadline 27s
        retry max 2
        idempotency request.prompt
    protocol Session27 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08561.compatibility_report
