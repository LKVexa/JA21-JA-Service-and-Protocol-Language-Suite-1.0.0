module corpus.ja_service.example_08881
use Service
policy explicit_network

service ServiceJASP_08881 {
    message Request56 { prompt: Text }
    message Response56 { token: Text, done: Flag }
    endpoint infer(request: Request56) -> Stream<Response56>
        auth capability model.infer
        deadline 56s
        retry max 0
        idempotency request.prompt
    protocol Session56 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08881.compatibility_report
