module corpus.ja_service.example_08410
use Service
policy explicit_network

service ServiceJASP_08410 {
    message Request70 { prompt: Text }
    message Response70 { token: Text, done: Flag }
    endpoint infer(request: Request70) -> Stream<Response70>
        auth capability model.infer
        deadline 70s
        retry max 2
        idempotency request.prompt
    protocol Session70 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_08410.compatibility_report
