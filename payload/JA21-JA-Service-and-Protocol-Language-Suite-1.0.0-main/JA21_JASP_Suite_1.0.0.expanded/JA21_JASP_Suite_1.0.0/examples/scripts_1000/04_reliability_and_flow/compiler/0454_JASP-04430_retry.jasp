module corpus.ja_service.example_04430
use Service
policy explicit_network

service ServiceJASP_04430 {
    message Request67 { prompt: Text }
    message Response67 { token: Text, done: Flag }
    endpoint infer(request: Request67) -> Stream<Response67>
        auth capability model.infer
        deadline 67s
        retry max 1
        idempotency request.prompt
    protocol Session67 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04430.compatibility_report
