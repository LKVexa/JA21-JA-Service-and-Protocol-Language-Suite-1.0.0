module corpus.ja_service.example_04896
use Service
policy explicit_network

service ServiceJASP_04896 {
    message Request48 { prompt: Text }
    message Response48 { token: Text, done: Flag }
    endpoint infer(request: Request48) -> Stream<Response48>
        auth capability model.infer
        deadline 48s
        retry max 2
        idempotency request.prompt
    protocol Session48 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_04896.compatibility_report
