module corpus.ja_service.example_04412
use Service
policy explicit_network

service ServiceJASP_04412 {
    message Request49 { prompt: Text }
    message Response49 { token: Text, done: Flag }
    endpoint infer(request: Request49) -> Stream<Response49>
        auth capability model.infer
        deadline 49s
        retry max 3
        idempotency request.prompt
    protocol Session49 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04412.compatibility_report
