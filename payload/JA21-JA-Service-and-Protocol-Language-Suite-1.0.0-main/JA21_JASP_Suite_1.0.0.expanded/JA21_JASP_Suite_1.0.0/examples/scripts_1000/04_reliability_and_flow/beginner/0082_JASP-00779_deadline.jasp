module corpus.ja_service.example_00779
use Service
policy explicit_network

service ServiceJASP_00779 {
    message Request5 { prompt: Text }
    message Response5 { token: Text, done: Flag }
    endpoint infer(request: Request5) -> Stream<Response5>
        auth capability model.infer
        deadline 5s
        retry max 1
        idempotency request.prompt
    protocol Session5 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_00779.compatibility_report
