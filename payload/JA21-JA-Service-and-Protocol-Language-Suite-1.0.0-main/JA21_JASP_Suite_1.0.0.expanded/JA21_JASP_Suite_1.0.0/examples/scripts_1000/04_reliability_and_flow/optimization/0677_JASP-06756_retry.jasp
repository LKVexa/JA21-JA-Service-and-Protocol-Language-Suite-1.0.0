module corpus.ja_service.example_06756
use Service
policy explicit_network

service ServiceJASP_06756 {
    message Request65 { prompt: Text }
    message Response65 { token: Text, done: Flag }
    endpoint infer(request: Request65) -> Stream<Response65>
        auth capability model.infer
        deadline 65s
        retry max 2
        idempotency request.prompt
    protocol Session65 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06756.compatibility_report
