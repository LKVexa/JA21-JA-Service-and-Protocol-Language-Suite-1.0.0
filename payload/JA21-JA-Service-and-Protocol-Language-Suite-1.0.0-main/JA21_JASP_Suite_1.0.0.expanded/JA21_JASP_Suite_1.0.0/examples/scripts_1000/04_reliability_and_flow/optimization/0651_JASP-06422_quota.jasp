module corpus.ja_service.example_06422
use Service
policy explicit_network

service ServiceJASP_06422 {
    message Request22 { prompt: Text }
    message Response22 { token: Text, done: Flag }
    endpoint infer(request: Request22) -> Stream<Response22>
        auth capability model.infer
        deadline 22s
        retry max 2
        idempotency request.prompt
    protocol Session22 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06422.compatibility_report
