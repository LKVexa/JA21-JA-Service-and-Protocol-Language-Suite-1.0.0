module corpus.ja_service.example_06052
use Service
policy explicit_network

service ServiceJASP_06052 {
    message Request40 { prompt: Text }
    message Response40 { token: Text, done: Flag }
    endpoint infer(request: Request40) -> Stream<Response40>
        auth capability model.infer
        deadline 40s
        retry max 0
        idempotency request.prompt
    protocol Session40 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06052.compatibility_report
