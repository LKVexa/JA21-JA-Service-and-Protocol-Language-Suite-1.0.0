module corpus.ja_service.example_06404
use Service
policy explicit_network

service ServiceJASP_06404 {
    message Request4 { prompt: Text }
    message Response4 { token: Text, done: Flag }
    endpoint infer(request: Request4) -> Stream<Response4>
        auth capability model.infer
        deadline 4s
        retry max 3
        idempotency request.prompt
    protocol Session4 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06404.compatibility_report
