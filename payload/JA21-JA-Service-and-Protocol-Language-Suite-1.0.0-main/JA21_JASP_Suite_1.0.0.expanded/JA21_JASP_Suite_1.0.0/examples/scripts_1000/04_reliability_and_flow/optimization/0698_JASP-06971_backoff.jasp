module corpus.ja_service.example_06971
use Service
policy explicit_network

service ServiceJASP_06971 {
    message Request86 { prompt: Text }
    message Response86 { token: Text, done: Flag }
    endpoint infer(request: Request86) -> Stream<Response86>
        auth capability model.infer
        deadline 86s
        retry max 0
        idempotency request.prompt
    protocol Session86 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06971.compatibility_report
