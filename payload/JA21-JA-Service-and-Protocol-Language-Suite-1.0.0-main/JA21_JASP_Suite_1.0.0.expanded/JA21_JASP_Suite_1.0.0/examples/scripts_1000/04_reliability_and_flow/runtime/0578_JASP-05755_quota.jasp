module corpus.ja_service.example_05755
use Service
policy explicit_network

service ServiceJASP_05755 {
    message Request34 { prompt: Text }
    message Response34 { token: Text, done: Flag }
    endpoint infer(request: Request34) -> Stream<Response34>
        auth capability model.infer
        deadline 34s
        retry max 1
        idempotency request.prompt
    protocol Session34 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05755.compatibility_report
