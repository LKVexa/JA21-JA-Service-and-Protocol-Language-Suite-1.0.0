module corpus.ja_service.example_07932
use Service
policy explicit_network

service ServiceJASP_07932 {
    message Request77 { prompt: Text }
    message Response77 { token: Text, done: Flag }
    endpoint infer(request: Request77) -> Stream<Response77>
        auth capability model.infer
        deadline 77s
        retry max 0
        idempotency request.prompt
    protocol Session77 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_07932.compatibility_report
