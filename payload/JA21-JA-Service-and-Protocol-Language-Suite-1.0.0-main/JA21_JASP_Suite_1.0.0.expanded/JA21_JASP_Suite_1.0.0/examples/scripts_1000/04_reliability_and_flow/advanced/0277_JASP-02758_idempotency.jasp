module corpus.ja_service.example_02758
use Service
policy explicit_network

service ServiceJASP_02758 {
    message Request44 { prompt: Text }
    message Response44 { token: Text, done: Flag }
    endpoint infer(request: Request44) -> Stream<Response44>
        auth capability model.infer
        deadline 44s
        retry max 3
        idempotency request.prompt
    protocol Session44 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02758.compatibility_report
