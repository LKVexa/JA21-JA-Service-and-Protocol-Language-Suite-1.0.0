module corpus.ja_service.example_02954
use Service
policy explicit_network

service ServiceJASP_02954 {
    message Request46 { prompt: Text }
    message Response46 { token: Text, done: Flag }
    endpoint infer(request: Request46) -> Stream<Response46>
        auth capability model.infer
        deadline 46s
        retry max 2
        idempotency request.prompt
    protocol Session46 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02954.compatibility_report
