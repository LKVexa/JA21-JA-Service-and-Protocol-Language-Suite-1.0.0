module corpus.ja_service.example_02410
use Service
policy explicit_network

service ServiceJASP_02410 {
    message Request84 { prompt: Text }
    message Response84 { token: Text, done: Flag }
    endpoint infer(request: Request84) -> Stream<Response84>
        auth capability model.infer
        deadline 84s
        retry max 0
        idempotency request.prompt
    protocol Session84 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02410.compatibility_report
