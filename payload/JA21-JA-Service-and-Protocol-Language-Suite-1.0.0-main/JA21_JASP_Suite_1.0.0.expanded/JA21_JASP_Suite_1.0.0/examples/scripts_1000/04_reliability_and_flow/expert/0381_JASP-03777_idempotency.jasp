module corpus.ja_service.example_03777
use Service
policy explicit_network

service ServiceJASP_03777 {
    message Request93 { prompt: Text }
    message Response93 { token: Text, done: Flag }
    endpoint infer(request: Request93) -> Stream<Response93>
        auth capability model.infer
        deadline 93s
        retry max 3
        idempotency request.prompt
    protocol Session93 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03777.compatibility_report
