module corpus.ja_service.example_03973
use Service
policy explicit_network

service ServiceJASP_03973 {
    message Request95 { prompt: Text }
    message Response95 { token: Text, done: Flag }
    endpoint infer(request: Request95) -> Stream<Response95>
        auth capability model.infer
        deadline 95s
        retry max 2
        idempotency request.prompt
    protocol Session95 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03973.compatibility_report
