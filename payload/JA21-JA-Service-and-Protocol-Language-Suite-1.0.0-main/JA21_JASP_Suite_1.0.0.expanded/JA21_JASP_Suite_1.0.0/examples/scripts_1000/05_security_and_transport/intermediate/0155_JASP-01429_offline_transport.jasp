module corpus.ja_service.example_01429
use Service
policy explicit_network

service ServiceJASP_01429 {
    message Request73 { prompt: Text }
    message Response73 { token: Text, done: Flag }
    endpoint infer(request: Request73) -> Stream<Response73>
        auth capability model.infer
        deadline 73s
        retry max 0
        idempotency request.prompt
    protocol Session73 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01429.compatibility_report
