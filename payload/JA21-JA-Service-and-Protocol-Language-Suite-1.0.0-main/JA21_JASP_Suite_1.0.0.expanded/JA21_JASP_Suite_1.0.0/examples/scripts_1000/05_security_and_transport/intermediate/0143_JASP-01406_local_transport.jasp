module corpus.ja_service.example_01406
use Service
policy explicit_network

service ServiceJASP_01406 {
    message Request50 { prompt: Text }
    message Response50 { token: Text, done: Flag }
    endpoint infer(request: Request50) -> Stream<Response50>
        auth capability model.infer
        deadline 50s
        retry max 0
        idempotency request.prompt
    protocol Session50 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_01406.compatibility_report
