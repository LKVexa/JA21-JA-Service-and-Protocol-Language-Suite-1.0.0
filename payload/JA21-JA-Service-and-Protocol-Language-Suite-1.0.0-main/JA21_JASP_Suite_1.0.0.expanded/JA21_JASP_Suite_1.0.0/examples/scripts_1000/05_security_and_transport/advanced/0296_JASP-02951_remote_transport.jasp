module corpus.ja_service.example_02951
use Service
policy explicit_network

service ServiceJASP_02951 {
    message Request43 { prompt: Text }
    message Response43 { token: Text, done: Flag }
    endpoint infer(request: Request43) -> Stream<Response43>
        auth capability model.infer
        deadline 43s
        retry max 3
        idempotency request.prompt
    protocol Session43 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02951.compatibility_report
