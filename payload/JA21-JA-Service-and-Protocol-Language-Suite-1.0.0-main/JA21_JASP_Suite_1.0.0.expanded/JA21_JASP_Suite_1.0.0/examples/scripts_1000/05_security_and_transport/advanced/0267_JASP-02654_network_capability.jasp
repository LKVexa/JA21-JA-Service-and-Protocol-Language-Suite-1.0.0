module corpus.ja_service.example_02654
use Service
policy explicit_network

service ServiceJASP_02654 {
    message Request37 { prompt: Text }
    message Response37 { token: Text, done: Flag }
    endpoint infer(request: Request37) -> Stream<Response37>
        auth capability model.infer
        deadline 37s
        retry max 0
        idempotency request.prompt
    protocol Session37 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02654.compatibility_report
