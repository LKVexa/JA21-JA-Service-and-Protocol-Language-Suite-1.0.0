module corpus.ja_service.example_02009
use Service
policy explicit_network

service ServiceJASP_02009 {
    message Request71 { prompt: Text }
    message Response71 { token: Text, done: Flag }
    endpoint infer(request: Request71) -> Stream<Response71>
        auth capability model.infer
        deadline 71s
        retry max 2
        idempotency request.prompt
    protocol Session71 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_02009.compatibility_report
