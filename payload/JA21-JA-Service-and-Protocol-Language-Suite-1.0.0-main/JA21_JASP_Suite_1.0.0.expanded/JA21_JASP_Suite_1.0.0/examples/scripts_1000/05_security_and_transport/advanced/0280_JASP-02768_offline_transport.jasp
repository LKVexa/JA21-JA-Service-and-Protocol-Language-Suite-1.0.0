module corpus.ja_service.example_02768
use Service
policy explicit_network

service ServiceJASP_02768 {
    message Request54 { prompt: Text }
    message Response54 { token: Text, done: Flag }
    endpoint infer(request: Request54) -> Stream<Response54>
        auth capability model.infer
        deadline 54s
        retry max 2
        idempotency request.prompt
    protocol Session54 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_02768.compatibility_report
