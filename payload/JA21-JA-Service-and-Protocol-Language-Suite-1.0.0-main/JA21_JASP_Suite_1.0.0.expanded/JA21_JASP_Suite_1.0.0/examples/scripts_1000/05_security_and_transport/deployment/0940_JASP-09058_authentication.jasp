module corpus.ja_service.example_09058
use Service
policy explicit_network

service ServiceJASP_09058 {
    message Request39 { prompt: Text }
    message Response39 { token: Text, done: Flag }
    endpoint infer(request: Request39) -> Stream<Response39>
        auth capability model.infer
        deadline 39s
        retry max 3
        idempotency request.prompt
    protocol Session39 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09058.compatibility_report
