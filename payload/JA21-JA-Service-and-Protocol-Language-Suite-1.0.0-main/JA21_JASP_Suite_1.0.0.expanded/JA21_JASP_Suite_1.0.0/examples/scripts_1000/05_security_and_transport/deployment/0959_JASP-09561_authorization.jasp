module corpus.ja_service.example_09561
use Service
policy explicit_network

service ServiceJASP_09561 {
    message Request57 { prompt: Text }
    message Response57 { token: Text, done: Flag }
    endpoint infer(request: Request57) -> Stream<Response57>
        auth capability model.infer
        deadline 57s
        retry max 2
        idempotency request.prompt
    protocol Session57 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_09561.compatibility_report
