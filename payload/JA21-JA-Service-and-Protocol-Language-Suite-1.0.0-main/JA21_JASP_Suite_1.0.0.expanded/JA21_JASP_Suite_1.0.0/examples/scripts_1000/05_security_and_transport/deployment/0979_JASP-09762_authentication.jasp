module corpus.ja_service.example_09762
use Service
policy explicit_network

service ServiceJASP_09762 {
    message Request64 { prompt: Text }
    message Response64 { token: Text, done: Flag }
    endpoint infer(request: Request64) -> Stream<Response64>
        auth capability model.infer
        deadline 64s
        retry max 1
        idempotency request.prompt
    protocol Session64 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09762.compatibility_report
