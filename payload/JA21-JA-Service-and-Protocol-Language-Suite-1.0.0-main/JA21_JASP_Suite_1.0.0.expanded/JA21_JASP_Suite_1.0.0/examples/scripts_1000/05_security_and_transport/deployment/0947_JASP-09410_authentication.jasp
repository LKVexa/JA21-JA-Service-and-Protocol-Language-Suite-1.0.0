module corpus.ja_service.example_09410
use Service
policy explicit_network

service ServiceJASP_09410 {
    message Request3 { prompt: Text }
    message Response3 { token: Text, done: Flag }
    endpoint infer(request: Request3) -> Stream<Response3>
        auth capability model.infer
        deadline 3s
        retry max 2
        idempotency request.prompt
    protocol Session3 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09410.compatibility_report
