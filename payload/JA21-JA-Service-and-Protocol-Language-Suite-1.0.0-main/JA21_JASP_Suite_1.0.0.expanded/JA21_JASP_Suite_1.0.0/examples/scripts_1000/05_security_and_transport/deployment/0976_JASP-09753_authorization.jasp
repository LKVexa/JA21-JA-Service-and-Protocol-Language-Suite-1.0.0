module corpus.ja_service.example_09753
use Service
policy explicit_network

service ServiceJASP_09753 {
    message Request55 { prompt: Text }
    message Response55 { token: Text, done: Flag }
    endpoint infer(request: Request55) -> Stream<Response55>
        auth capability model.infer
        deadline 55s
        retry max 0
        idempotency request.prompt
    protocol Session55 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_09753.compatibility_report
