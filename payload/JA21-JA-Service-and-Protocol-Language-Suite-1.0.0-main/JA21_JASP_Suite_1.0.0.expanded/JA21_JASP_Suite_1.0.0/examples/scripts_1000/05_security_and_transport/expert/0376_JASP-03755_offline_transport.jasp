module corpus.ja_service.example_03755
use Service
policy explicit_network

service ServiceJASP_03755 {
    message Request71 { prompt: Text }
    message Response71 { token: Text, done: Flag }
    endpoint infer(request: Request71) -> Stream<Response71>
        auth capability model.infer
        deadline 71s
        retry max 1
        idempotency request.prompt
    protocol Session71 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_03755.compatibility_report
