module corpus.ja_service.example_08676
use Service
policy explicit_network

service ServiceJASP_08676 {
    message Request45 { prompt: Text }
    message Response45 { token: Text, done: Flag }
    endpoint infer(request: Request45) -> Stream<Response45>
        auth capability model.infer
        deadline 45s
        retry max 0
        idempotency request.prompt
    protocol Session45 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08676.compatibility_report
