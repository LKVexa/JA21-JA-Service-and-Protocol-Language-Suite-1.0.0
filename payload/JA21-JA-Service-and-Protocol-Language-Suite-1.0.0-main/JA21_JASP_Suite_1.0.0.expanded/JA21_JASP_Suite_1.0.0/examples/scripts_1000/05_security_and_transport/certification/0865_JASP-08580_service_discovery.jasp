module corpus.ja_service.example_08580
use Service
policy explicit_network

service ServiceJASP_08580 {
    message Request46 { prompt: Text }
    message Response46 { token: Text, done: Flag }
    endpoint infer(request: Request46) -> Stream<Response46>
        auth capability model.infer
        deadline 46s
        retry max 1
        idempotency request.prompt
    protocol Session46 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08580.compatibility_report
