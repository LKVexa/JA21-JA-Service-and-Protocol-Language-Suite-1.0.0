module corpus.ja_service.example_08894
use Service
policy explicit_network

service ServiceJASP_08894 {
    message Request69 { prompt: Text }
    message Response69 { token: Text, done: Flag }
    endpoint infer(request: Request69) -> Stream<Response69>
        auth capability model.infer
        deadline 69s
        retry max 1
        idempotency request.prompt
    protocol Session69 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_08894.compatibility_report
