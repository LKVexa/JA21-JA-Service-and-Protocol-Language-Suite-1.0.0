module corpus.ja_service.example_00419
use Service
policy explicit_network

service ServiceJASP_00419 {
    message Request33 { prompt: Text }
    message Response33 { token: Text, done: Flag }
    endpoint infer(request: Request33) -> Stream<Response33>
        auth capability model.infer
        deadline 33s
        retry max 1
        idempotency request.prompt
    protocol Session33 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_00419.compatibility_report
