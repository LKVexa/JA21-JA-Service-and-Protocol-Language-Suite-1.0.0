module corpus.ja_service.example_00017
use Service
policy explicit_network

service ServiceJASP_00017 {
    message Request19 { prompt: Text }
    message Response19 { token: Text, done: Flag }
    endpoint infer(request: Request19) -> Stream<Response19>
        auth capability model.infer
        deadline 19s
        retry max 2
        idempotency request.prompt
    protocol Session19 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_00017.compatibility_report
