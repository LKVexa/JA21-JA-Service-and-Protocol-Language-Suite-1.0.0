module corpus.ja_service.example_04422
use Service
policy explicit_network

service ServiceJASP_04422 {
    message Request59 { prompt: Text }
    message Response59 { token: Text, done: Flag }
    endpoint infer(request: Request59) -> Stream<Response59>
        auth capability model.infer
        deadline 59s
        retry max 1
        idempotency request.prompt
    protocol Session59 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_04422.compatibility_report
