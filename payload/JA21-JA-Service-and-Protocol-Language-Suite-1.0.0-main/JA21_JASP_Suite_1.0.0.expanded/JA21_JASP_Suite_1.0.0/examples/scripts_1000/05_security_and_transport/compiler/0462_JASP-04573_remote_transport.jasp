module corpus.ja_service.example_04573
use Service
policy explicit_network

service ServiceJASP_04573 {
    message Request16 { prompt: Text }
    message Response16 { token: Text, done: Flag }
    endpoint infer(request: Request16) -> Stream<Response16>
        auth capability model.infer
        deadline 16s
        retry max 1
        idempotency request.prompt
    protocol Session16 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_04573.compatibility_report
