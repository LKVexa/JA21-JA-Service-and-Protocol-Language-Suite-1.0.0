module corpus.ja_service.example_05409
use Service
policy explicit_network

service ServiceJASP_05409 {
    message Request76 { prompt: Text }
    message Response76 { token: Text, done: Flag }
    endpoint infer(request: Request76) -> Stream<Response76>
        auth capability model.infer
        deadline 76s
        retry max 0
        idempotency request.prompt
    protocol Session76 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05409.compatibility_report
