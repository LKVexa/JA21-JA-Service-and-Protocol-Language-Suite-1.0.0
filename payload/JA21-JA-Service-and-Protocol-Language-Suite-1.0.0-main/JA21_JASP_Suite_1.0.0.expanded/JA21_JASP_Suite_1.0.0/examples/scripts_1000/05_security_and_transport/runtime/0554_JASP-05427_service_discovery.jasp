module corpus.ja_service.example_05427
use Service
policy explicit_network

service ServiceJASP_05427 {
    message Request94 { prompt: Text }
    message Response94 { token: Text, done: Flag }
    endpoint infer(request: Request94) -> Stream<Response94>
        auth capability model.infer
        deadline 94s
        retry max 3
        idempotency request.prompt
    protocol Session94 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05427.compatibility_report
