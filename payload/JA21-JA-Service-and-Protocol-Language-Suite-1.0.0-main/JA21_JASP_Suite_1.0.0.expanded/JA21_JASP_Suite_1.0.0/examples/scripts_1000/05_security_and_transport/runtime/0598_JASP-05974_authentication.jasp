module corpus.ja_service.example_05974
use Service
policy explicit_network

service ServiceJASP_05974 {
    message Request59 { prompt: Text }
    message Response59 { token: Text, done: Flag }
    endpoint infer(request: Request59) -> Stream<Response59>
        auth capability model.infer
        deadline 59s
        retry max 3
        idempotency request.prompt
    protocol Session59 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05974.compatibility_report
