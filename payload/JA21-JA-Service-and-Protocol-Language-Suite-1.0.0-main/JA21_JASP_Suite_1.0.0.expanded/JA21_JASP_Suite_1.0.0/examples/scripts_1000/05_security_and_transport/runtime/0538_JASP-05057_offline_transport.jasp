module corpus.ja_service.example_05057
use Service
policy explicit_network

service ServiceJASP_05057 {
    message Request15 { prompt: Text }
    message Response15 { token: Text, done: Flag }
    endpoint infer(request: Request15) -> Stream<Response15>
        auth capability model.infer
        deadline 15s
        retry max 1
        idempotency request.prompt
    protocol Session15 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_05057.compatibility_report
