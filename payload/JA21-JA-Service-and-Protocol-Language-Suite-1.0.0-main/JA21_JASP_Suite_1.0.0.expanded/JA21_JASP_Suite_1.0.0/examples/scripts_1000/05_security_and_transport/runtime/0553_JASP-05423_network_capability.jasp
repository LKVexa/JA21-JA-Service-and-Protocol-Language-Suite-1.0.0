module corpus.ja_service.example_05423
use Service
policy explicit_network

service ServiceJASP_05423 {
    message Request90 { prompt: Text }
    message Response90 { token: Text, done: Flag }
    endpoint infer(request: Request90) -> Stream<Response90>
        auth capability model.infer
        deadline 90s
        retry max 2
        idempotency request.prompt
    protocol Session90 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05423.compatibility_report
