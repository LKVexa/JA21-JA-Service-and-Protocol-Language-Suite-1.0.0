module corpus.ja_service.example_05752
use Service
policy explicit_network

service ServiceJASP_05752 {
    message Request31 { prompt: Text }
    message Response31 { token: Text, done: Flag }
    endpoint infer(request: Request31) -> Stream<Response31>
        auth capability model.infer
        deadline 31s
        retry max 2
        idempotency request.prompt
    protocol Session31 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_05752.compatibility_report
