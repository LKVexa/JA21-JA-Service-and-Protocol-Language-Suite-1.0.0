module corpus.ja_service.example_06929
use Service
policy explicit_network

service ServiceJASP_06929 {
    message Request44 { prompt: Text }
    message Response44 { token: Text, done: Flag }
    endpoint infer(request: Request44) -> Stream<Response44>
        auth capability model.infer
        deadline 44s
        retry max 1
        idempotency request.prompt
    protocol Session44 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06929.compatibility_report
