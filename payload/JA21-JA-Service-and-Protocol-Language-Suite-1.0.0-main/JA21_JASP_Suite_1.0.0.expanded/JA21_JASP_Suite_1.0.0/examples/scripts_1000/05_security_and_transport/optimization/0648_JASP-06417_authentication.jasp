module corpus.ja_service.example_06417
use Service
policy explicit_network

service ServiceJASP_06417 {
    message Request17 { prompt: Text }
    message Response17 { token: Text, done: Flag }
    endpoint infer(request: Request17) -> Stream<Response17>
        auth capability model.infer
        deadline 17s
        retry max 1
        idempotency request.prompt
    protocol Session17 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06417.compatibility_report
