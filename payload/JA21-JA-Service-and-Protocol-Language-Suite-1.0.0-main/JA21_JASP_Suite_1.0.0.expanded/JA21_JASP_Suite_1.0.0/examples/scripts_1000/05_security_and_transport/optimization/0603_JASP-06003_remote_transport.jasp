module corpus.ja_service.example_06003
use Service
policy explicit_network

service ServiceJASP_06003 {
    message Request88 { prompt: Text }
    message Response88 { token: Text, done: Flag }
    endpoint infer(request: Request88) -> Stream<Response88>
        auth capability model.infer
        deadline 88s
        retry max 1
        idempotency request.prompt
    protocol Session88 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_06003.compatibility_report
