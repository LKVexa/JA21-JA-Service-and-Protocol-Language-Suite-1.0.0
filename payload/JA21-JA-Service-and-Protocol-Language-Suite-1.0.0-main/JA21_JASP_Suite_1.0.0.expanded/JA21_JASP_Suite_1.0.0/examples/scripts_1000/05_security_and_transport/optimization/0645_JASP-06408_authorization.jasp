module corpus.ja_service.example_06408
use Service
policy explicit_network

service ServiceJASP_06408 {
    message Request8 { prompt: Text }
    message Response8 { token: Text, done: Flag }
    endpoint infer(request: Request8) -> Stream<Response8>
        auth capability model.infer
        deadline 8s
        retry max 3
        idempotency request.prompt
    protocol Session8 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_06408.compatibility_report
