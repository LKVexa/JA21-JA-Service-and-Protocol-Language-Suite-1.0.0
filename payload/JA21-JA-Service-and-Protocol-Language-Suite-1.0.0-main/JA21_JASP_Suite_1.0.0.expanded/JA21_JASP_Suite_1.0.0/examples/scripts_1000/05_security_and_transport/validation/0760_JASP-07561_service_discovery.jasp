module corpus.ja_service.example_07561
use Service
policy explicit_network

service ServiceJASP_07561 {
    message Request94 { prompt: Text }
    message Response94 { token: Text, done: Flag }
    endpoint infer(request: Request94) -> Stream<Response94>
        auth capability model.infer
        deadline 94s
        retry max 1
        idempotency request.prompt
    protocol Session94 {
        state Open
        state Closed
        transition finish: Open -> Closed
    }
}
assert protocol.transition.valid == true
emit json ServiceJASP_07561.compatibility_report
