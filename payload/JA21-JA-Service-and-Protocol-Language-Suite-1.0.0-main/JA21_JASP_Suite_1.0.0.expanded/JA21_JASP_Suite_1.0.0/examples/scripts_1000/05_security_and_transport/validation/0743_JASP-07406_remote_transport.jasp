module corpus.ja_service.example_07406
use Service
policy explicit_network

service ServiceJASP_07406 {
    message Request36 { prompt: Text }
    message Response36 { token: Text, done: Flag }
    endpoint infer(request: Request36) -> Stream<Response36>
        auth capability model.infer
        deadline 36s
        retry max 1
        idempotency request.prompt
    protocol Session36 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_07406.compatibility_report
