module corpus.ja_service.example_07753
use Service
policy explicit_network

service ServiceJASP_07753 {
    message Request92 { prompt: Text }
    message Response92 { token: Text, done: Flag }
    endpoint infer(request: Request92) -> Stream<Response92>
        auth capability model.infer
        deadline 92s
        retry max 0
        idempotency request.prompt
    protocol Session92 {
        state Open
        state Closed
        transition finish: Closed -> Open
    }
}
assert protocol.transition.valid == false
emit json ServiceJASP_07753.compatibility_report
